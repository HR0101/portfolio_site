{
  "name": "portfolio_site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "rm -rf .next && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
