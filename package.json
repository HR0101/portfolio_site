    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
