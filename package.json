{
  "name": "portfolio_site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "docker:up": "docker compose up --build -d --wait web",
    "docker:down": "docker compose down",
    "docker:test": "docker compose --profile test run --build --rm test",
    "build": "rm -rf .next && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/e2e.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "snapshot": "node scripts/fetch-github-snapshot.mjs",
    "build:static": "node scripts/build-static.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs",
    "deploy:aws:publish": "node scripts/deploy-aws.mjs --publish-only",
    "deploy:aws:preflight": "node scripts/deploy-aws.mjs --preflight",
    "deploy:aws:check": "node scripts/deploy-aws.mjs --check-local"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "next": "16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
